; Engine configuration file.
; 雾林微光 · Fogwood — original fog / atmosphere tech demo.
; Godot 4.6 / GL Compatibility / 1280x720 logical canvas / procedural low-poly scene.

config_version=5

[application]

config/name="雾林微光 · Fogwood"
config/description="原创低模雾林：指数高度雾 + 深度雾 + 雾片 + 伪光束 + 浮尘 + 第三人称角色与动态雾驱散，可交互技术 demo。"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.055, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
