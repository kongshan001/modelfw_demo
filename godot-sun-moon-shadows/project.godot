; Engine configuration file.
; Sun & Moon Shadows · 日月双影 — clean-room 2D pixel day/night shadow study.
; Original code and procedurally generated pixel art only.

config_version=5

[application]

config/name="Sun & Moon Shadows · 日月双影"
config/description="A fixed-camera 2D pixel glade where one shared main-light channel drives warm sun shadows by day and cool moon shadows by night: 3 shader globals, vertex-collapse union shadows, a single-channel R8 height map and a 60% soft-knee length curve. No Light2D and no per-object shadow casters."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.085, 1)

[shader_globals]

u_light_dir={
"type": "vec4",
"value": Vector4(0, -1, 0.9, 0)
}
u_light_color={
"type": "color",
"value": Color(1, 0.96, 0.85, 1)
}
u_ambient_sub={
"type": "color",
"value": Color(0.10, 0.16, 0.26, 0.36)
}
