; Reelward — a slot-reel auto-battler vertical slice (clean-room, procedural pixel art).

config_version=5

[application]

config/name="Reelward - 转轮守卫"
config/description="A 3x3 reel auto-battler: spin to summon defenders, hold one lane, shop to bend the odds."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.071, 0.063, 0.11, 1)
textures/canvas_textures/default_texture_filter=0
