; Engine configuration file.
; 云璃背包 — original inventory UI study, Godot 4.6 (GL Compatibility).

config_version=5

[application]

config/name="云璃背包 · 物品界面"
config/description="An original, data-driven inventory UI demo: paper-doll equipment ring, bag pages, filters, item actions and animated transitions."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icons/icon_pouch.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.02, 0.055, 0.08, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_mouse_from_touch=true

[debug]

gdscript/warnings/untyped_declaration=0
