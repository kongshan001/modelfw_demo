    "design_resolution": [
      1280,
      720
    ],
    "layout_spec": "export/ui_layout.json",
    "license_doc": "CREDITS.md"
  },
  "license": {
    "default": "original",
    "statement": "本清单内所有图像/矢量/数据均为本项目原创或程序化生成；未使用第三方游戏美术、图库素材、参考游戏截图/图标/Logo/UI 切图。参考截图仅用于数值测量，不入库、不随资产包分发。",
    "reference_included": false,
    "third_party_art": "none",
    "project_license": "仓库未附独立 LICENSE 文件；对外分发前需由项目所有者确定授权条款（CREDITS.md 提供原创声明与来源说明）。",
    "fonts": "未打包字体；运行时使用系统 CJK 字体。对外发布请替换为 OFL 字体并随包附带其许可。",
    "trademark": "不使用《幻唐志》名称/Logo 作为产品名；demo 名为「云璃背包」，角色为原创「青丘灵狐·云璃」。"
  },
  "naming": {
    "icons": "assets/icons/icon_<key>.svg；<key> 与 data/items.json 的 icon 字段一一对应",
    "ui": "assets/ui/<name>.png；<name> 用 snake_case：panel/close/glow/sparkle/vignette",
    "background": "assets/bg/<name>.png",
    "character": "assets/char/<name>.svg",
    "ids": "manifest id = 文件名去扩展名；item icon 的 icon_key = id 去掉 icon_ 前缀",
    "case": "全小写 + 下划线；不使用空格/中文文件名"
  },
  "conventions": {
    "design_px": [
      1280,
      720
    ],
    "ui_scale": "2× source for the panel; icons imported at 256×256 from a 128-unit viewBox; close at 232×232",
    "filtering": "linear (not nearest); no pixel-art palette",
    "alpha": "straight alpha (Godot import premultiplied=false)",
    "mipmaps": false,
    "color_space": "sRGB",
    "atlas": "none in this build; batching is a known optimization (344 draw calls at 1920×1080)",
    "nine_slice_policy": "本资产包没有为九宫格切图；panel 以整图拉伸，按钮/格子/页签由运行时渐变绘制。若移植侧必须用 9-slice 纹理，panel 建议源图 margin 120px，按钮建议设计 px margin 12（2× 源图 24px）。"
  },
