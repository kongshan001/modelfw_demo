class_name SwarmArt
extends RefCounted

## Central art registry for Swarmforge (T-20261126-026).
## All textures are original, generated by tools/art_gen/*.py and recorded in
## CREDITS.md / assets/art/PROVENANCE.md. No third-party game art is used.

const Cards = preload("res://scripts/swarm_cards.gd")

const UNIT_ATLAS: Texture2D = preload("res://assets/art/units/unit_atlas_10x12_768x640.png")
const CARD_ATLAS: Texture2D = preload("res://assets/art/cards/card_atlas_1024x768.png")
const ICON_ATLAS: Texture2D = preload("res://assets/art/ui/icons_20.png")
const ARENA: Texture2D = preload("res://assets/art/env/arena_1800x570.png")
const FLAG_ALLY: Texture2D = preload("res://assets/art/env/flag_ally_96x192.png")
const FLAG_ENEMY: Texture2D = preload("res://assets/art/env/flag_enemy_96x192.png")
const FOG_A: Texture2D = preload("res://assets/art/env/fog_0.png")
const FOG_B: Texture2D = preload("res://assets/art/env/fog_1.png")
const VFX_ATLAS: Texture2D = preload("res://assets/art/vfx/vfx_atlas_96x192.png")
const KEYART: Texture2D = preload("res://assets/art/keyart/victory_1920x1080.png")

const UNIT_SHADER: Shader = preload("res://assets/shaders/unit_atlas.gdshader")
const FX_SHADER: Shader = preload("res://assets/shaders/fx_atlas.gdshader")
const FOG_SHADER: Shader = preload("res://assets/shaders/fog.gdshader")
const FLAG_SHADER: Shader = preload("res://assets/shaders/flag.gdshader")

const ICON_NAMES := [
	"coin", "furnace", "star", "hp", "atk", "aspd", "range", "refresh",
	"level", "greed", "flood", "code", "melee", "ranged", "support", "tank", "splash",
]

static var _icon_cache: Dictionary = {}


static func card_index(id: String) -> int:
	for i in Cards.CARD_LIST.size():
		if String(Cards.CARD_LIST[i]["id"]) == id:
			return i
	return 0


static func card_region(index: int) -> Rect2:
	var col := index % 4
	var row := index / 4
	return Rect2(col * 256, row * 256, 256, 256)


static func icon_region(name: String) -> Rect2:
	var idx := ICON_NAMES.find(name)
	if idx < 0:
		idx = 0
	return Rect2(idx * 20, 0, 20, 20)


static func draw_icon(ci: CanvasItem, name: String, pos: Vector2, size: float, color: Color) -> void:
	ci.draw_texture_rect_region(ICON_ATLAS, Rect2(pos, Vector2(size, size)),
		icon_region(name), color)


static func draw_card_art(ci: CanvasItem, card_id: String, rect: Rect2) -> void:
	ci.draw_texture_rect_region(CARD_ATLAS, rect, card_region(card_index(card_id)))


static func icon_texture(name: String) -> AtlasTexture:
	if _icon_cache.has(name):
		return _icon_cache[name]
	var t := AtlasTexture.new()
	t.atlas = ICON_ATLAS
	t.region = icon_region(name)
	_icon_cache[name] = t
	return t


static func role_icon(card: Dictionary) -> String:
	if card.is_empty():
		return "melee"
	if bool(card.get("support", false)):
		return "support"
	if float(card.get("splash", 0.0)) > 0.0:
		return "splash"
	if bool(card.get("tank", false)):
		return "tank"
	if float(card.get("range", 0.0)) > 40.0:
		return "ranged"
	return "melee"


static func role_icon_for_label(label: String) -> String:
	match label:
		"支援":
			return "support"
		"溅射":
			return "splash"
		"重甲":
			return "tank"
		"远程":
			return "ranged"
		_:
			return "melee"


static func unit_material() -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = UNIT_SHADER
	return m


static func fx_material() -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = FX_SHADER
	return m


static func fog_material(scroll: Vector2, tint: Color) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = FOG_SHADER
	m.set_shader_parameter("scroll", scroll)
	m.set_shader_parameter("tint", tint)
	return m


static func flag_material() -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = FLAG_SHADER
	return m
