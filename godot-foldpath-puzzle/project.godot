; Foldpath · 折径 — an original isometric impossible-geometry puzzle vertical slice.
; Godot 4.6 / GL Compatibility. Geometry, materials, UI and audio are generated at runtime.

config_version=5

[application]

config/name="Foldpath · 折径"
config/description="把两段在屏幕上重合的路，折成一条能走的路。原创等轴不可能几何解谜。"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.76, 0.83, 0.79, 1)
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[physics]

common/physics_ticks_per_second=60

[input_devices]

pointing/emulate_mouse_from_touch=true
