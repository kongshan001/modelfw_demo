# Product Scout · 环境变量示例
# 复制为 .env.local 后填写；.env.local 已在 .gitignore 中，不会被提交。
# 默认的 Demo 模式不需要任何 key，可直接启动体验。

# ---------------------------------------------------------------------------
# 搜索 provider
# mock（默认，离线样例）| serper | tavily | brave | serpapi
# 一次只启用一个；key 只放在服务端环境变量，绝不写进前端或仓库。
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=mock

# 每个 provider 最多展示的结果数，范围 3–10
SEARCH_RESULT_LIMIT=6

# 搜索地区与语言（主要供 Serper / SerpAPI 使用）
SEARCH_COUNTRY=cn
SEARCH_LANGUAGE=zh-cn

# 选择一个 Live provider 时，只需填写对应的 key：
# Serper.dev · Google Shopping（购物搜索每次约 2 credits）
SERPER_API_KEY=
# Tavily · 公开网页搜索（basic 每次约 1 credit）
TAVILY_API_KEY=
# Brave Search API · 公开网页搜索
BRAVE_API_KEY=
# SerpAPI · Google Shopping
SERPAPI_API_KEY=

# ---------------------------------------------------------------------------
# 视觉识别 provider
# demo（默认）| openai
# demo 不调用任何外部视觉服务，字段来自内置样例并明确标注。
# openai 指任意 OpenAI 兼容的 /chat/completions 视觉接口：
#   OpenAI:  https://api.openai.com/v1
#   火山方舟: https://ark.cn-beijing.volces.com/api/v3
#   VISION_MODEL 填模型名或 Ark 的 endpoint id。
# 注意：配置后，用户截图会以 base64 发送到该接口，仅用于本次识别；
#       服务端不写入磁盘或数据库，日志不记录图片。
# ---------------------------------------------------------------------------
VISION_PROVIDER=demo
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
