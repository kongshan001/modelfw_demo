; Mosslight Isle · 苔光浮庭
; Original procedural healing garden scene. No external art assets.

config_version=5

[application]

config/name="Mosslight Isle · 苔光浮庭"
config/description="原创程序化治愈庭园 vertical slice：浮空苔岛、月树、苔灯、水塘锦鲤、茶亭风铃与苔猫。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/size/resizable=true
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.025, 0.026, 0.055, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[audio]

driver/enable_input=false
