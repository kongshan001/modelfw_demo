; Engine configuration file.
; Mellis HB-7 — Godot 3D teardown study (clean-room, procedural geometry).

config_version=5

[application]

config/name="Mellis HB-7 - Godot teardown study"
config/description="A procedural robotic-bee field simulator: exploded view, isolate, labels, auto tour and a single solver driving both motion and telemetry."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.94902, 0.933333, 0.890196, 1)
