; Engine configuration file.
; Tidal Garden · 潮汐花园 — one water shader for sea / river / lake.
; Original code and procedurally generated pixel art only.

config_version=5

[application]

config/name="Tidal Garden · 潮汐花园"
config/description="One 2D water shader for sea, river and inland lake: 16px mask downsample, 2-pass 8-neighbour depth, zero-allocation BFS classification, Voronoi caustics and double shore wavefronts."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.07, 0.07, 1)
