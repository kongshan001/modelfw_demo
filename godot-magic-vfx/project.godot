; Magic Projectile Lab — Godot 4.6, GL Compatibility, 1280x720 logical.
; Original VFX demo inspired by the technique in Le Lu's "VFX for Games #11"
; (fireball head mesh + scrolling flame trail + sparks + moving light).

config_version=5

[application]

config/name="Magic Projectile Lab · 魔法发射实验室"
config/description="Interactive 3D magic projectile VFX: charge, launch, flame trail, impact and afterglow. Original procedural art, Godot 4.6 GL Compatibility."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/dpi/allow_hidpi=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.016, 0.021, 0.039, 1)
